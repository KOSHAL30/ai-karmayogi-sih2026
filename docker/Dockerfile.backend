# ==============================================================================
# AI KARMAYOGI — BACKEND PRODUCTION DOCKERFILE
# Python 3.12 Slim + PyMuPDF C-dependencies + Uvicorn
# ==============================================================================

FROM python:3.12-slim AS base

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies needed for PyMuPDF, psycopg2/asyncpg, and curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    gcc \
    mupdf \
    libmupdf-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Create non-root user and uploads directory
RUN addgroup --system karmayogi && \
    adduser --system --ingroup karmayogi karmayogi && \
    mkdir -p /app/uploads && \
    chown -R karmayogi:karmayogi /app

# Copy application source code
COPY backend/app /app/app
COPY backend/services /app/services
COPY backend/repositories /app/repositories
COPY backend/ai /app/ai
COPY backend/alembic /app/alembic
COPY backend/alembic.ini /app/alembic.ini

USER karmayogi

EXPOSE 8000

# Health check against API healthz endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Launch production ASGI server with multiple workers
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips", "*"]
