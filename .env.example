# ==============================================================================
# AI KARMAYOGI — ENVIRONMENT CONFIGURATION
# MongoDB Atlas + Groq AI | SIH26101
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="AI Karmayogi"
API_V1_STR=/api/v1

# Security & JWT Tokens
JWT_SECRET=sovereign_secret_key_sih2026_dopt_mission_karmayogi_secure_random_seed_99482
JWT_REFRESH_SECRET=sovereign_refresh_secret_sih2026_dopt_mission_karmayogi_token_seed_88312
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Atlas
MONGODB_URI=mongodb+srv://karmayogi_admin:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_karmayogi

# LLM Provider (groq | ollama)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen-qwq-32b

# Ollama — optional fallback for embeddings and local LLM
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Document Upload & Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Public Environment Variables
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE="AI Karmayogi"
